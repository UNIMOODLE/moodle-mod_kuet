{{!
    @template mod_kuet/step_2

    Session step 2

    Classes required for JS:
    * None

    Data attibutes required for JS:
    * None

    Context variables required for this template:
    * none

    Example context (json):
    {
    }
}}
<div class="content-header">
    <div class="content-title">
        <h2>{{#str}}questionsconfiguration, mod_kuet{{/str}}</h2>
        <small>{{#str}}questionsconfiguration_info, mod_kuet{{/str}}</small>
    </div>
    <div class="session-steps">
        <div class="step step1">
            <div class="timeline timeline-r"></div>
            <span class="step-text"></span>
        </div>
        <div class="step step2 current">
            <div class="timeline timeline-r"></div>
            <div class="timeline timeline-l"></div>
            <span class="step-text bg-primary">2</span>
        </div>
        <div class="step step3">
            <div class="timeline timeline-l"></div>
            <span class="step-text"></span>
        </div>
    </div>
</div>
<div class="row questions-configuration">
    <div class="col-12 col-lg-8 container">
        <div class="questions-list">
            <h6 class="titlecontainer bg-primary">
                {{#pix}} i/questions_list, mod_kuet {{/pix}}
                {{#str}}questions_list, mod_kuet{{/str}}
            </h6>
            <div class="session-questions" data-region="session-questions">
                {{> mod_kuet/createsession/sessionquestions }}
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4 container">
        {{#canaddquestions}}
            {{#hasquestionbanks}}
                <button type="button" class="btn btn-primary" data-action="open-kuet-bank">
                    {{#str}}addfromquestionbank, mod_kuet{{/str}}
                </button>
                <template data-region="kuet-bank-picker">
                    <label for="kuet-bank-select">{{#str}}selectquestionbank, mod_kuet{{/str}}</label>
                    <select id="kuet-bank-select" class="form-control mb-3" data-action="select-kuet-bank">
                        {{#questionbanks}}<option value="{{cmid}}">{{name}}</option>{{/questionbanks}}
                    </select>
                    <label><input type="checkbox" data-action="kuet-latest-version">
                        {{#str}}uselatestready, mod_kuet{{/str}}
                    </label>
                    <p class="small text-muted">{{#str}}uselatestready_help, mod_kuet{{/str}}</p>
                    <div data-region="kuet-bank-content"></div>
                </template>
            {{/hasquestionbanks}}
            {{^hasquestionbanks}}<p>{{#str}}noquestionbanks, mod_kuet{{/str}}</p>{{/hasquestionbanks}}
        {{/canaddquestions}}
        {{^canaddquestions}}<p>{{#str}}sessionquestionslocked, mod_kuet{{/str}}</p>{{/canaddquestions}}
    </div>
    <div class="col-12">
        <hr>
        <div class="d-flex flex-nowrap align-items-center justify-content-center">
            <div class="form-group fitem btn-cancel mr-3">
                <span data-fieldtype="submit">
                    <a href="{{formurl}}" class="btn btn-secondary">
                        {{#str}}previous, moodle{{/str}}
                    </a>
                </span>
            </div>
            <div class="form-group fitem">
                <span data-fieldtype="submit">
                    <a href="{{resumeurl}}" class="btn btn-primary">
                        {{#str}}next, moodle{{/str}}
                    </a>
                </span>
            </div>
        </div>
    </div>
</div>
{{#js}}
    require(['mod_kuet/questionbank'], function(QuestionBank) {
        QuestionBank.init({{contextid}}, {{cmid}}, {{kuetid}}, {{sid}});
    });
{{/js}}