<div class="col-12 col-lg-8 container">
    <div class="questions-list">
        <h6 class="titlecontainer bg-primary">
            {{#pix}} i/questions_list, mod_kuet {{/pix}}
            {{#str}}questions_list, mod_kuet{{/str}}
        </h6>
        <div class="session-questions" data-region="session-questions">
            {{> mod_kuet/createsession/sessionquestions }}
        </div>
    </div>
</div>
<div class="col-12 col-lg-4 container">
    <div id="questions-bank" class="questions-bank" data-questionbankcmid="{{questionbankcmid}}">
        <h6 class="titlecontainer bg-primary">
            {{#pix}} i/questions_list, mod_kuet {{/pix}}
            {{#str}}questions_bank, mod_kuet{{/str}}
        </h6>
        <div class="form-group">

            <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
                <div id="elena">
                    {{#hasquestionbankname}}
                    <span class="bold">{{#str}}thisquestionbank, mod_kuet{{/str}}</span>
                    <span id="currentbank">{{questionbankname}}</span>
                    {{/hasquestionbankname}}
                </div>
                <div>
                    <a class="btn btn-primary" href="#" data-action="change_questionbank" data-cmid="{{cmid}}" data-contextid = "{{contextid}}" data-kuetid = "{{kuetid}}" data-sid = "{{sid}}" data-questionbankcmid="{{questionbankcmid}}" title="{{#str}}changequestionbank, mod_kuet{{/str}}">
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M6.75 9C6.75 10.245 7.755 11.25 9 11.25C10.245 11.25 11.25 10.245 11.25 9C11.25 7.755 10.245 6.75 9 6.75C7.755 6.75 6.75 7.755 6.75 9Z" fill="white"/>
                            <path d="M6 6.75C6 6.3375 5.6625 6 5.25 6H3.8175C4.8525 4.2075 6.7875 3 9 3C11.6175 3 13.8375 4.68 14.655 7.02C14.76 7.3125 15.0525 7.5 15.36 7.5C15.87 7.5 16.245 6.9975 16.08 6.5175C15.0525 3.5925 12.27 1.5 9 1.5C6.5475 1.5 4.365 2.685 3 4.5075V3.75C3 3.3375 2.6625 3 2.25 3C1.8375 3 1.5 3.3375 1.5 3.75V6.75C1.5 7.1625 1.8375 7.5 2.25 7.5H5.25C5.6625 7.5 6 7.1625 6 6.75Z" fill="white"/>
                            <path d="M12 11.25C12 11.6625 12.3375 12 12.75 12H14.1825C13.1475 13.7925 11.2125 15 9 15C6.3825 15 4.1625 13.32 3.345 10.98C3.24 10.6875 2.9475 10.5 2.64 10.5C2.13 10.5 1.755 11.0025 1.92 11.4825C2.9475 14.4075 5.73 16.5 9 16.5C11.4525 16.5 13.635 15.315 15 13.4925V14.25C15 14.6625 15.3375 15 15.75 15C16.1625 15 16.5 14.6625 16.5 14.25V11.25C16.5 10.8375 16.1625 10.5 15.75 10.5H12.75C12.3375 10.5 12 10.8375 12 11.25Z" fill="white"/>
                        </svg>
                    </a>
                    <a class="btn btn-primary" href="{{questionbank_url}}" target="_blank" title="{{#str}}go_questionbank, mod_kuet{{/str}}">
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M13.5 14.25H4.5C4.0875 14.25 3.75 13.9125 3.75 13.5V4.5C3.75 4.0875 4.0875 3.75 4.5 3.75H8.25C8.6625 3.75 9 3.4125 9 3C9 2.5875 8.6625 2.25 8.25 2.25H3.75C2.9175 2.25 2.25 2.925 2.25 3.75V14.25C2.25 15.075 2.925 15.75 3.75 15.75H14.25C15.075 15.75 15.75 15.075 15.75 14.25V9.75C15.75 9.3375 15.4125 9 15 9C14.5875 9 14.25 9.3375 14.25 9.75V13.5C14.25 13.9125 13.9125 14.25 13.5 14.25ZM10.5 3C10.5 3.4125 10.8375 3.75 11.25 3.75H13.1925L6.345 10.5975C6.0525 10.89 6.0525 11.3625 6.345 11.655C6.6375 11.9475 7.11 11.9475 7.4025 11.655L14.25 4.8075V6.75C14.25 7.1625 14.5875 7.5 15 7.5C15.4125 7.5 15.75 7.1625 15.75 6.75V2.25H11.25C10.8375 2.25 10.5 2.5875 10.5 3Z" fill="white"/>
                        </svg>

                    </a>
                </div>
            </div>
            <span>{{#str}}select_category, mod_kuet{{/str}}</span>
            {{{questionbank_categories}}}
        </div>
        <hr>
        <div class="content-question" data-region="content-question">
            {{> mod_kuet/createsession/contentquestions }}
        </div>
    </div>
</div>
<div class="col-12">
    <hr>
    <div class="d-flex flex-nowrap align-items-center justify-content-center">
        <div class="form-group fitem btn-cancel mr-3">
                <span data-fieldtype="submit">
                    <a href="{{formurl}}" class="btn btn-secondary">
                        {{#str}}previous, moodle{{/str}}
                    </a>
                </span>
        </div>
        <div class="form-group fitem">
                <span data-fieldtype="submit">
                    <a href="{{resumeurl}}" class="btn btn-primary">
                        {{#str}}next, moodle{{/str}}
                    </a>
                </span>
        </div>
    </div>
</div>
{{#js}}
    require(['mod_kuet/questionspanel'],
    function(QuestionsPanel) {
    QuestionsPanel.initQuestionsPanel('[data-region="questions-panel"]');
    }
    );
{{/js}}
