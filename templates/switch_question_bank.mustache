{{!
    @template mod_kuet/switch_question_bank

    Lists the question banks a session can take its questions from.

    Same three blocks as core_question/switch_question_bank, without the one that
    heads it there: a link to the question bank of the activity itself, which a kuet
    does not have. See \mod_kuet\output\switch_question_bank.

    Context variables required for this template:
    * kuetcontextid - Context id of the kuet, read by the search field.
    * hascoursesharedbanks - Whether the course has shared banks to offer.
    * coursesharedbanks - Shared banks of the course, with modid and name.
    * hasrecentlyviewedbanks - Whether the user has recently used banks.
    * recentlyviewedbanks - Those banks, with modid and coursenamebankname.

    Example context (json):
    {
        "kuetcontextid": 1,
        "hascoursesharedbanks": true,
        "coursesharedbanks": [
            {
                "modid": 2,
                "name": "Question bank 1"
            }
        ],
        "hasrecentlyviewedbanks": true,
        "recentlyviewedbanks": [
            {
                "modid": 3,
                "coursenamebankname": "Course 1 - Question bank 2"
            }
        ]
    }
}}
{{#hascoursesharedbanks}}
    <div class="course-shared-banks">
        <h5>{{#str}}banksincourse, core_question{{/str}}</h5>
        {{#coursesharedbanks}}
            <ul class="list-unstyled ms-3">
                <li>
                    <a href="#" data-newmodid="{{modid}}">{{name}}</a>
                </li>
            </ul>
        {{/coursesharedbanks}}
    </div>
    <hr class="w-75">
{{/hascoursesharedbanks}}

{{#hasrecentlyviewedbanks}}
    <div class="recently-viewed-banks">
        <h5>{{#str}}recentlyviewedquestionbanks, core_question{{/str}}</h5>
        {{#recentlyviewedbanks}}
            <ul class="list-unstyled ms-3">
                <li>
                    <a href="#" data-newmodid="{{modid}}">{{coursenamebankname}}</a>
                </li>
            </ul>
        {{/recentlyviewedbanks}}
    </div>
    <hr class="w-75">
{{/hasrecentlyviewedbanks}}

<div class="search-banks">
    <h5>{{#str}}otherquestionbank, core_question{{/str}}</h5>
    <select class="form-select" id="searchbanks" data-contextid="{{kuetcontextid}}">
    </select>
</div>
